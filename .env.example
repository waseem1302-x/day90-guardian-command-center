# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  For local-only development, set AUTH_BYPASS=true below. Keep it false for
#  any shared, staging, or production deployment.
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass is for local development only. Keep false for any shared/public deployment.
AUTH_BYPASS=false

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# Hosted demo protection (set these only in the Vercel environment manager).
# Leave both auth flags false for local Docker.
DEMO_AUTH_REQUIRED=false
NEXT_PUBLIC_DEMO_AUTH_REQUIRED=false
DEMO_ACCESS_PASSWORD=
BACKEND_ORIGIN=
INTERNAL_SERVICE_TOKEN=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev

# ------------------------------------------------------------
# DAY90 GUARDIAN ROUND 2 LIVE INTEGRATIONS
# ------------------------------------------------------------
# Local development can run from the mounted Round 2 CSV folder.
# For the final judged proof, seed Supabase and add these values.
DAY90_DATASET_DIR=/app/day90_dataset

# System of record
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supervity Auto orchestration
SUPERVITY_WORKFLOW_EXECUTE_URL=
SUPERVITY_API_KEY=

# Human channel / task systems
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=
# Optional: use a reviewer GID; if blank, Asana assigns created tasks to the token owner.
ASANA_ASSIGNEE_GID=
# Optional route-specific reviewer and business-day deadline overrides.
ASANA_AMBER_ASSIGNEE_GID=
ASANA_RED_ASSIGNEE_GID=
ASANA_AMBER_DUE_DAYS=1
ASANA_RED_DUE_DAYS=0

# Performance cache for derived Day90 profile reads
DAY90_PROFILE_CACHE_TTL_SECONDS=3600
